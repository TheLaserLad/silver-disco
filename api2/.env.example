# Growth page on the race desk. Do not put a real token in git.
# Keep the live .env. Add a line only when you are ready for the page to
# read the player service. The race-desk session cookie is not a Node admin login.
#
# PLAYER_API_BASE_URL defaults to http://127.0.0.1:8080 when unset.
# PLAYER_API_ADMIN_TOKEN is the player API adminToken cookie (Node authenticateAdmin).
# Leave it unset until you have that cookie. The Growth page then shows the
# safe off position and does not save. Never commit the token.

PLAYER_API_BASE_URL=http://127.0.0.1:8080
PLAYER_API_ADMIN_TOKEN=
