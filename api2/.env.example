# Optional. The Growth page calls the player API on this machine.
# Do not put a real token in git. The live server .env is kept as-is on deploy.
#
# PLAYER_API_BASE_URL defaults to http://127.0.0.1:8080 when unset.
# PLAYER_API_ADMIN_TOKEN is optional. Leave it blank to sign a short-lived
# adminToken with JWT_SECRET_KEY (already on this service) for a player
# account whose userType is Admin.
# Set PLAYER_API_ADMIN_TOKEN only if you already have a working Node adminToken
# cookie value. Never commit that value.

PLAYER_API_BASE_URL=http://127.0.0.1:8080
PLAYER_API_ADMIN_TOKEN=
